    "linker_vars": ""
  },
  {
    "target_name": "zephyr-nrf52840dk-encryption",
    "build_cmd": "\"$MEMBROWSE_SCRIPTS/zephyr-build.sh\" nrf52840dk/nrf52840 build-nrf52840dk-encryption -DCONFIG_BOOT_ENCRYPT_IMAGE=y",
    "elf": "build-nrf52840dk-encryption/zephyr/zephyr.elf",
    "ld": "build-nrf52840dk-encryption/zephyr/linker.cmd",
    "map_file": "build-nrf52840dk-encryption/zephyr/zephyr.map",
    "linker_vars": ""
  },
  {
